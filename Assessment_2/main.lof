\contentsline {figure}{\numberline {1}{\ignorespaces Visualisation of the simplified structure of a field programmable gate array.}}{3}{figure.caption.2}%
\contentsline {figure}{\numberline {2}{\ignorespaces Visualisation of the compilation and execution of code on a supercomputer using field programmable gate arrays. Compared to the process for existing implementations on a GPU.}}{3}{figure.caption.3}%
\contentsline {figure}{\numberline {3}{\ignorespaces Monomolecular chain model for the production and degredation of two molecules.}}{4}{figure.caption.4}%
\contentsline {figure}{\numberline {4}{\ignorespaces Example Euler-Maruyama method sample path of the Monomolecular chain model using C++ on a GPU. With kinetic rate parameters $k_1 = 1.0$, $k_2 = 0.1$ and $k_3 = 0.05$, initial conditions $A(0) = 100$, $B(0) = 0$, final time $T = 100$.}}{5}{figure.caption.5}%
\contentsline {figure}{\numberline {5}{\ignorespaces Block diagram of the Euler-Maruyamaa simulation method using the Monomolecular chain model. Synthesis generated through the system link .xclbin file generated through compilation. As viewed in Vivado through the \textit {block diagram viewer}.}}{6}{figure.caption.6}%
\contentsline {figure}{\numberline {6}{\ignorespaces Register resource utilisation generated by a single simulation kernel of the Euler-Maruyama method using a Monomolecular chain model. Data generated through the .xclbin system linking compilation and viewed in Vivado Vitis.}}{7}{figure.caption.7}%
\contentsline {figure}{\numberline {7}{\ignorespaces (\textbf {blue/red}) Euler-Maruyama method sample path of the Monomolecular chain model using C++/OpenCL on a GPU. (\textbf {black/green}) Euler-Maruyama method sample path of the Monomolecular chain model using C++/HLS on an emulated FPGA. Both models follow kinetic rate parameters $k_1 = 1.0$, $k_2 = 0.1$ and $k_3 = 0.05$, initial conditions $A(0) = 100$, $B(0) = 0$, final time $T = 100$.}}{8}{figure.caption.8}%
\contentsline {figure}{\numberline {8}{\ignorespaces \textbf {(blue/red solid line)} Mean path of a Euler-Maruyama method simulation of the Monomolecular chain model using C++/HLS on an emulated FPGA. \textbf {(blue/red shaded area)} Standard deviation of the same Euler-Maruyama method simulation pathway. Following kinetic rate parameters $k_1 = 1.0$, $k_2 = 0.1$ and $k_3 = 0.05$, initial conditions $A(0) = 100$, $B(0) = 0$, final time $T = 100$, number of simulation $N=10$.}}{8}{figure.caption.9}%
\contentsline {figure}{\numberline {9}{\ignorespaces Schematic of vector unit operations in single instruction single data and single instruction multiple data configurations with varying precision levels.}}{14}{figure.caption.10}%
