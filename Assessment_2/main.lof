\contentsline {figure}{\numberline {1}{\ignorespaces Visualisation of the simplified structure of a field programmable gate array.}}{3}{figure.caption.2}%
\contentsline {figure}{\numberline {2}{\ignorespaces Visualisation of the compilation and execution of code on a supercomputer using field programmable gate arrays. \texthl {HLS C++ code $\rightarrow $ system linking $\rightarrow $ logic synthesis $\rightarrow $ routing $\rightarrow $ bitstream generation --- describe the processes the user is involved with and what is handled by the compiler}}}{3}{figure.caption.3}%
\contentsline {figure}{\numberline {3}{\ignorespaces Monomolecular chain model for the production and degredation of two molecules.}}{4}{figure.caption.4}%
