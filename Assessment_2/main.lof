\contentsline {figure}{\numberline {7}{\ignorespaces (\textbf {blue/red}) Euler-Maruyama method sample path of the Monomolecular chain model using C++/OpenCL on a GPU. (\textbf {black/green}) Euler-Maruyama method sample path of the Monomolecular chain model using C++/HLS on an emulated FPGA. Both models follow kinetic rate parameters $k_1 = 1.0$, $k_2 = 0.1$ and $k_3 = 0.05$, initial conditions $A(0) = 100$, $B(0) = 0$, final time $T = 100$.}}{8}{figure.caption.8}%
\contentsline {figure}{\numberline {8}{\ignorespaces \textbf {(blue/red solid line)} Mean path of a Euler-Maruyama method simulation of the Monomolecular chain model using C++/HLS on an emulated FPGA. \textbf {(blue/red shaded area)} Standard deviation of the same Euler-Maruyama method simulation pathway. Following kinetic rate parameters $k_1 = 1.0$, $k_2 = 0.1$ and $k_3 = 0.05$, initial conditions $A(0) = 100$, $B(0) = 0$, final time $T = 100$, number of simulation $N=10$.}}{9}{figure.caption.9}%
