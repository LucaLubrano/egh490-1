  pages = {190--197},
  publisher = {Nature Publishing Group},
  issn = {1546-170X},
  doi = {10.1038/nm0296-190},
  urldate = {2025-10-22},
  abstract = {To study the behavior of hematopoietic stem cells in vivo, hematopoiesis was simulated by assuming that all stem cell decisions (that is, replication, apoptosis, initiation of a differentiation/maturation program) were determined by chance. Predicted outcomes from simulated experiments were compared with data obtained in autologous marrow transplantation studies of glucose 6--phosphate dehydrogenase (G6PD) heterozygous female Safari cats. With this approach, we prove that stochastic differentiation can result in the wide spectrum of discrete outcomes observed in vivo, and that clonal dominance can occur by chance. As the analyses also suggest that the frequency of feline hematopoietic stem cells is only 6 per 107 nucleated marrow cells, and that stem cells do not replicate on average more frequently than once every three weeks, these large--animal data challenge clinical strategies for marrow transplantation and gene therapy.},
  copyright = {1996 Springer Nature America, Inc.},
  langid = {english},
  keywords = {Biomedicine,Cancer Research,general,Infectious Diseases,Metabolic Diseases,Molecular Medicine,Neurosciences},
  file = {/home/luca-lubrano/Zotero/storage/9M9XMI38/Abkowitz et al. - 1996 - Evidence that hematopoiesis may be a stochastic process in vivo.pdf}
}

