@article{barashPRANDGPUAccelerated2014,
  title = {{{PRAND}}: {{GPU}} Accelerated Parallel Random Number Generation Library: {{Using}} Most Reliable Algorithms and Applying Parallelism of Modern {{GPUs}} and {{CPUs}}},
