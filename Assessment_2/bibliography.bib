  keywords = {Accuracy,Acoustics,Autonomous underwater vehicle,Autonomous underwater vehicles,AUV navigation,Data loss,Doppler sonar,Earth rotation,factor graph optimistic,Failure,Fourier transforms,Graphs,Image registration,IMU pre-integration,Inertial measurement unit,Inertial navigation,Inertial platforms,Influence,Integration,Methods,Navigation,Navigation systems,Ocean floor,Position measurement,Registration,Side scan sonar,side-scan sonar,Side-scan sonar,SINS/DVL,Sonar,Strapdown inertial navigation,Systems stability,Underwater vehicle,Underwater vehicles,Velocity},
