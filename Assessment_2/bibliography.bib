  pmid = {34194954},
  keywords = {climate change,computational research,green computing},
  file = {/home/luca-lubrano/Zotero/storage/8VFQY263/Lannelongue et al. - 2021 - Green Algorithms Quantifying the Carbon Footprint of Computation.pdf}
