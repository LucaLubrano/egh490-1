@article{andersonErrorAnalysisTauleap2011,
  title = {Error Analysis of Tau-Leap Simulation Methods},
  author = {Anderson, David F. and Ganguly, Arnab and Kurtz, Thomas G.},
  year = 2011,
  month = dec,
  journal = {The Annals of Applied Probability},
  volume = {21},
