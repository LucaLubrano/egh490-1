  langid = {english},
  keywords = {Accuracy,Acoustics,Algorithms,Autonomous underwater vehicle,Autonomous Underwater Vehicle(s),Autonomous underwater vehicles,Collaboration,collaborative AUVs,Communication,Global positioning systems--GPS,Localization,Maps,Methods,Navigation,Navigation systems,Sensors,Surveillance,Underwater environment,underwater localization,Underwater vehicle,Vehicles,Velocity,Wireless networks},
  file = {/home/luca-lubrano/Zotero/storage/KMUQQML2/González-García et al. - 2020 - Autonomous Underwater Vehicles Localization, Navigation, and Communication for Collaborative Missio.pdf}
